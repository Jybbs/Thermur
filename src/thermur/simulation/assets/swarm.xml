<?xml version="1.0" encoding="UTF-8"?>
<mujoco model="swarm">

    <option 
        integrator = "RK4"
        timestep   = "$TIMESTEP$"
    >
        <flag 
            contact = "disable" 
            energy  = "enable" 
            gravity = "enable"
        />
    </option>

    <default>
        <geom 
            conaffinity = "1" 
            condim      = "3" 
            contype     = "1" 
            friction    = "1 0.5 0.5" 
            margin      = "0.01"
        />
        <joint 
            armature    = "0.1" 
            damping     = "0.1" 
            limited     = "true"
        />
        <motor 
            ctrllimited = "true"
            ctrlrange   = "-1 1"
        />
    </default>
    
    <worldbody>

        <geom 
            name  = "ground" 
            pos   = "0 0 -0.1" 
            rgba  = "0.7 0.7 0.7 1"
            size  = "100 100 0.1" 
            type  = "plane"
        />
        
        <!-- DRONE_BODIES -->
        
    </worldbody>

    <actuator>
        <!-- ACTUATORS -->
    </actuator>

</mujoco>
